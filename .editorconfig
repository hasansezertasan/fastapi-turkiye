# editorconfig/Generic@f64e011 — https://raw.githubusercontent.com/vinibrsl/editorconfig-templates/f64e011b04669db816b8075f3a9d4f3beb58c9d6/Generic.editorconfig
root = true

[*]
charset = utf-8
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.{json,json5}]
indent_size = 2

[*.{yml,yaml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.{htm,html,js,ts,tsx,css,sass,scss,less,svg,vue}]
indent_size = 2

[*.{xml,config}]
indent_size = 2

[*.{cmd,bat}]
end_of_line = crlf

[*.sh]
end_of_line = lf
# <<< cobo:end sha256=e77e873fad9f0ff5e000743b383685dae54dc35063610f628ff909e1de72e8bd <<<

# Project-specific overrides (later sections win over the cobo block above).
[*]
end_of_line = lf

# Files whose indentation is fixed by their generator or format, not by the
# Generic template's four-space default.
[*.{md,toml,jsonc}]
indent_size = 2

[.secrets.baseline]
indent_size = 2

[cobo.lock]
indent_size = 2

# .gitignore keeps the lone CR bytes of the macOS `Icon\r` patterns (cobo --eol lf).
[.gitignore]
end_of_line = unset
